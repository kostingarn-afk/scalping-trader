{
  "title": "Scalping Trading System — MVP",
  "uid": "scalping-mvp",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["scalping", "mvp"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(messages_published_total, service)",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Realized PnL", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "pnl_realized_total{service=\"trader\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyRUB" } }
    },
    {
      "id": 2, "title": "Unrealized PnL", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "pnl_unrealized{service=\"trader\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyRUB" } }
    },
    {
      "id": 3, "title": "Open Positions", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "positions_open{service=\"trader\"}", "refId": "A" }]
    },
    {
      "id": 4, "title": "Circuit Breaker Active", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "circuit_breaker_active{service=\"trader\"}", "refId": "A" }],
      "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
    },
    {
      "id": 10, "title": "Pipeline Latency (p99)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(analysis_latency_seconds_bucket[5m])) by (le))", "legendFormat": "analyzer p99", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11, "title": "Consumer Lag", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "consumer_lag", "legendFormat": "partition {{partition}}", "refId": "A" }]
    },
    {
      "id": 20, "title": "Signals/min", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(signals_generated_total[1m]) * 60", "legendFormat": "generated", "refId": "A" },
        { "expr": "rate(signals_rejected_total[1m]) * 60", "legendFormat": "rejected", "refId": "B" }
      ]
    },
    {
      "id": 21, "title": "Trades/min", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(orders_placed_total[1m]) * 60", "legendFormat": "placed", "refId": "A" },
        { "expr": "rate(orders_rejected_total[1m]) * 60", "legendFormat": "rejected", "refId": "B" }
      ]
    },
    {
      "id": 30, "title": "Messages Published (collector)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [{ "expr": "rate(messages_published_total[1m]) * 60", "legendFormat": "msg/min", "refId": "A" }]
    }
  ]
}
